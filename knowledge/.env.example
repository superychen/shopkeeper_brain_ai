# Copy this file to .env and fill in only the settings required locally.
# Do not commit secrets to version control.

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_VLM_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2

# 查询商品名确认：自动确认阈值固定 0.7，dense/sparse 权重固定 0.5/0.5。
QUERY_ITEM_MID_CONFIDENCE=0.45
QUERY_ITEM_SCORE_GAP=0.15
QUERY_ITEM_TOP_K=50
QUERY_ITEM_MAX_TOP_K=200
QUERY_LLM_MAX_TOKENS=1200

# BGE-M3 hybrid embedding
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_TOKENS=8192
MAX_IMPORT_CHUNKS=10000

# Milvus vector database
MILVUS_URL=http://127.0.0.1:19530
MILVUS_TOKEN=
ITEM_NAME_COLLECTION=kb_item_names_v1
CHUNKS_COLLECTION=kb_chunks_v1
MILVUS_BATCH_SIZE=128
MILVUS_MAX_BATCH_BYTES=4194304
MILVUS_TIMEOUT_SECONDS=30
MILVUS_MAX_RETRIES=2

# MinIO object storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge-base
MINIO_SECURE=false

# HTTP 导入服务：单个进程、一个后台工作线程；队列容量不包含正在执行的任务。
IMPORT_QUEUE_CAPACITY=10
IMPORT_MAX_FILE_BYTES=104857600
# 临时目录接纳阈值 5 GiB；失败文件默认保留 24 小时，成功归档后清理。
IMPORT_MAX_DISK_BYTES=5368709120
IMPORT_RETENTION_SECONDS=86400
CORS_ALLOW_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173

# 三路检索：正文 TopK 不采用商品确认的 0.7 阈值。
QUERY_DENSE_TOP_K=50
QUERY_SPARSE_TOP_K=50
QUERY_CHUNKS_PER_ITEM=5
QUERY_HYDE_ENABLED=true
QUERY_WEB_ENABLED=true
# 从用户指定百炼服务的“外部调用”复制，不能用控制台页面 URL。
BAILIAN_SEARCH_MCP_URL=
BAILIAN_SEARCH_TOOL_NAME=
DASHSCOPE_API_KEY=
