# Copy this file to .env and fill in only the settings required locally.
# Do not commit secrets to version control.

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_VLM_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2

# BGE-M3 hybrid embedding
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_TOKENS=8192
MAX_IMPORT_CHUNKS=10000

# Milvus vector database
MILVUS_URL=http://127.0.0.1:19530
MILVUS_TOKEN=
ITEM_NAME_COLLECTION=kb_item_names_v1
CHUNKS_COLLECTION=kb_chunks_v1
MILVUS_BATCH_SIZE=128
MILVUS_MAX_BATCH_BYTES=4194304
MILVUS_TIMEOUT_SECONDS=30
MILVUS_MAX_RETRIES=2

# MinIO object storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge-base
MINIO_SECURE=false
